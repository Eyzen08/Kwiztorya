<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brown"
    tools:context=".Home">

    <!-- Background Decoration Icons -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📜"
        android:textSize="50sp"
        android:alpha="0.1"
        android:layout_marginTop="80dp"
        android:layout_marginStart="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🏛️"
        android:textSize="36sp"
        android:alpha="0.1"
        android:layout_marginTop="160dp"
        android:layout_marginEnd="80dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚔️"
        android:textSize="44sp"
        android:alpha="0.1"
        android:layout_marginBottom="160dp"
        android:layout_marginStart="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🇵🇭"
        android:textSize="30sp"
        android:alpha="0.1"
        android:layout_marginBottom="80dp"
        android:layout_marginEnd="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Main Content Container -->
    <LinearLayout
        android:id="@+id/main_content_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        app:layout_constraintWidth_max="400dp"
        app:layout_constraintWidth_percent="0.9"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- App Title Section -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="32dp">

            <TextView
                android:id="@+id/text_logo_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KWIZTORYA"
                android:textSize="30sp"
                android:textColor="@color/light_beige"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:fontFamily="serif"
                android:layout_marginBottom="8dp" />

            <View
                android:layout_width="140dp"
                android:layout_height="4dp"
                android:background="@color/accent_gold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/text_logo_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Philippine History Trivia"
                android:textSize="16sp"
                android:textColor="@color/light_beige"
                android:alpha="0.9"
                android:fontFamily="sans-serif" />
        </LinearLayout>

        <!-- Profile Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/light_beige"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="20dp">

                <!-- Profile Icon -->
                <LinearLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/rounded_corner"
                    android:gravity="center"
                    android:layout_marginEnd="16dp">

                    <TextView
                        android:id="@+id/profile_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📚"
                        android:textSize="28sp" />
                </LinearLayout>

                <!-- Profile Info -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_profile_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/dark_brown"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:fontFamily="sans-serif-medium"
                        tools:text="History Master" />

                    <TextView
                        android:id="@+id/text_total_score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/dark_brown"
                        android:textSize="14sp"
                        android:alpha="0.8"
                        android:fontFamily="sans-serif"
                        tools:text="Total Score: 1,250 • 3/5 Eras" />
                </LinearLayout>

                <!-- Achievement Badge -->
                <LinearLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/rounded_corner"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/crown_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👑"
                        android:textSize="20sp"
                        android:contentDescription="Crown Icon" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Play Button -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/light_beige">

                <Button
                    android:id="@+id/btn_play"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/play"
                    android:textSize="16sp"
                    android:textColor="@color/dark_brown"
                    android:textStyle="bold"
                    android:background="@android:color/transparent"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp"
                    android:fontFamily="sans-serif-medium"
                    android:stateListAnimator="@null" />
            </androidx.cardview.widget.CardView>

            <!-- Story Mode Button -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/light_beige">

                <Button
                    android:id="@+id/btn_story_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/story_mode"
                    android:textSize="16sp"
                    android:textColor="@color/dark_brown"
                    android:textStyle="bold"
                    android:background="@android:color/transparent"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp"
                    android:fontFamily="sans-serif-medium"
                    android:stateListAnimator="@null" />
            </androidx.cardview.widget.CardView>

            <!-- Chapter Selection Button -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/light_beige">

                <Button
                    android:id="@+id/btn_chapter_selection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/chapter_selection"
                    android:textSize="16sp"
                    android:textColor="@color/dark_brown"
                    android:textStyle="bold"
                    android:background="@android:color/transparent"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp"
                    android:fontFamily="sans-serif-medium"
                    android:stateListAnimator="@null" />
            </androidx.cardview.widget.CardView>

            <!-- Settings Button -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/light_beige">

                <Button
                    android:id="@+id/btn_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings"
                    android:textSize="16sp"
                    android:textColor="@color/dark_brown"
                    android:textStyle="bold"
                    android:background="@android:color/transparent"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp"
                    android:fontFamily="sans-serif-medium"
                    android:stateListAnimator="@null" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </LinearLayout>

    <!-- Footer -->
    <TextView
        android:id="@+id/text_footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Learn • Play • Discover Philippine History"
        android:textColor="@color/light_beige"
        android:textSize="12sp"
        android:alpha="0.8"
        android:fontFamily="sans-serif"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>