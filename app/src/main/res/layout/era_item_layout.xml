<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="2dp"
    android:layout_marginEnd="2dp"
    android:layout_marginBottom="14dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardBackgroundColor="@color/archive_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="18dp"
        android:gravity="center_vertical">

        <!-- Era Icon Container -->
        <LinearLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/archive_icon_tile"
            android:gravity="center"
            android:layout_marginEnd="14dp">

            <ImageView
                android:id="@+id/era_icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />
        </LinearLayout>

        <!-- Era Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Era Title and Status -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/era_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Era Title"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/archive_ink"
                    android:fontFamily="sans-serif-medium"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@+id/era_status"
                    android:layout_centerVertical="true" />

                <TextView
                    android:id="@+id/era_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AVAILABLE"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/archive_olive"
                    android:background="@drawable/status_available"
                    android:paddingHorizontal="9dp"
                    android:paddingVertical="5dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true" />

                <ImageView
                    android:id="@+id/lock_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_lock"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:visibility="gone" />
            </RelativeLayout>

            <!-- Era Description -->
            <TextView
                android:id="@+id/era_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Era description goes here with more details about this historical period"
                android:textColor="@color/archive_ink"
                android:textSize="14sp"
                android:fontFamily="sans-serif"
                android:alpha="0.8"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="16dp" />

            <!-- Progress Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/era_questions"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="6 Historical Questions"
                    android:textSize="12sp"
                    android:textColor="@color/archive_ink"
                    android:fontFamily="sans-serif"
                    android:alpha="0.7" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EXPLORE →"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/archive_olive"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>